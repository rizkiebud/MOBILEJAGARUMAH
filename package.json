{
  "name": "MobileJagarUmah",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",

    "android": "react-native run-android",
    "android:debug": "react-native run-android --mode=debug",
    "android:release": "react-native run-android --mode=release",
    "android:device": "react-native run-android --active-arch-only",

    "ios": "react-native run-ios",
    "ios:debug": "react-native run-ios --configuration Debug",
    "ios:release": "react-native run-ios --configuration Release",
    "ios:device": "react-native run-ios --device",

    "build:apk": "cd android && ./gradlew assembleDebug",
    "build:apk:release": "cd android && ./gradlew assembleRelease",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "build:ios": "cd ios && xcodebuild -workspace MobileJagarUmah.xcworkspace -scheme MobileJagarUmah -configuration Release -sdk iphonesimulator",

    "clean": "react-native clean",
    "clean:android": "cd android && ./gradlew clean",
    "clean:ios": "cd ios && xcodebuild clean -workspace MobileJagarUmah.xcworkspace -scheme MobileJagarUmah",
    "clean:metro": "react-native start --reset-cache",

    "pod:install": "cd ios && pod install",
    "pod:update": "cd ios && pod update",

    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",

    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",

    "log:android": "react-native log-android",
    "log:ios": "react-native log-ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/slider": "^4.5.5",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@react-navigation/stack": "^7.1.0",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "^2.21.2",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^3.17.4",
    "react-native-safe-area-context": "^5.3.0",
    "react-native-screens": "^4.4.0",
    "react-native-svg": "^15.11.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-video": "^6.9.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^15.0.0",
    "@react-native-community/cli-platform-android": "^15.0.0",
    "@react-native-community/cli-platform-ios": "^15.0.0",
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "^0.81.0",
    "@react-native/eslint-config": "^0.81.0",
    "@react-native/metro-config": "^0.81.0",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "preset": "react-native"
  }
}
